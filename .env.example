PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
DB_PATH=./server/data/secret-bite.db
# sqlite se mantiene activo hasta ejecutar y verificar la migración.
DB_PROVIDER=sqlite
# Identificador visible en Configuración del proyecto de Firebase.
FIREBASE_PROJECT_ID=tu-proyecto-firebase
# Déjalo vacío para usar la base predeterminada `(default)`.
FIRESTORE_DATABASE_ID=
# Ruta absoluta al JSON privado. Nunca copies el JSON dentro del repositorio.
GOOGLE_APPLICATION_CREDENTIALS=C:\ruta-segura\firebase-service-account.json
# true para conectarse al emulador local (opcional).
FIRESTORE_EMULATOR_HOST=
VITE_API_URL=http://localhost:3001/api
NODE_ENV=development
