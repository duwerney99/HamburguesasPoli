{
  "name": "secret-bite-voting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Plataforma de votacion mensual Secret Bite",
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"node --watch server/src/index.js\" \"vite --config client/vite.config.js\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "start": "node server/src/index.js",
    "build": "vite build --config client/vite.config.js",
    "test": "vitest run --config vitest.config.js",
    "test:unit": "vitest run --config vitest.config.js",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "test:watch": "vitest --config vitest.config.js",
    "seed": "node server/src/seed.js",
    "firestore:check": "node server/src/firestore/check-connection.js",
    "firestore:migrate": "node server/src/firestore/migrate-from-sqlite.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.19.0"
}
